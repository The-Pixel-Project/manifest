<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="github"
           fetch="https://github.com/" />

  <remote  name="gitlab"
           fetch="https://gitlab.com/" />

  <remote  name="tpp"
           fetch="https://github.com/The-Pixel-Project"
           revision="refs/heads/15" />

  <remote  name="tpp-gitlab"
           fetch="https://gitlab.com/The-Pixel-Project"
           revision="refs/heads/15" />

  <!-- General Repos -->
  <project path="bionic" name="bionic" groups="pdk" remote="tpp" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="tpp" />
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="tpp">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed,sysui-studio" remote="tpp">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Devices Repos -->
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="tpp" />

  <!-- Frameworks Repos -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="tpp" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs" remote="tpp" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="tpp" />

  <!-- Packages Repos -->
  <project path="packages/apps/ParanoidSense" name="packages_apps_ParanoidSense" remote="tpp" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs" remote="tpp" />
  <project path="packages/apps/TouchGestures" name="packages_apps_TouchGestures" remote="tpp" />
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="tpp" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk" remote="tpp" />
  <project path="packages/services/Telecomm" name="packages_services_Telecomm" remote="tpp" />

  <!-- System Repos -->
  <project path="system/core" name="system_core" groups="pdk" remote="tpp" />

  <!-- Vendor Repos -->
  <project path="vendor/aosp" name="vendor_aosp" remote="tpp" />
  <project path="vendor/custom-preference" name="vendor_custom-preference" remote="tpp" />
  <project path="vendor/gms" name="vendor_gms" clone-depth="1" remote="tpp-gitlab" />
  <project path="vendor/google/overlays/ThemeIcons" name="vendor_google_overlays_ThemeIcons" remote="tpp" />

</manifest>
